# Copy to .env.deploy (it is in .gitignore). Never commit the real file.
FTP_HOST=ftp.example.com
FTP_USER=
FTP_PASS=''
FTP_REMOTE_DIR=/httpdocs

# Optional
# FTP_PORT=21
# FTP_PROTOCOL=ftp          # ftp = explicit TLS (port 21), ftps = implicit TLS (port 990)
# FTP_TLS=yes               # yes = never send the login unencrypted
# FTP_VERIFY_CERT=yes       # "no" only if the host's certificate cannot be verified
# FTP_CA_FILE=/etc/ssl/certs/ca-certificates.crt
# FTP_KEEP="uploads stats"  # extra top-level names on the server to never delete
