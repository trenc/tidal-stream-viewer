# Copy to .env (it is in .gitignore). Never commit the real file.
# On the server the same file lives above the document root.

# Required: your api-maree.fr key
MAREE_API_KEY=

# Optional: where the tide proxy keeps its cache (a relative path is resolved from the folder
# above the document root). Docker sets /var/cache/tides itself.
TIDE_CACHE_DIR=

# Optional usage limits of the tide proxy, per UTC hour.
# For one visitor address (default 30):
# TIDE_IP_HOURLY_BUDGET=30
# For the whole site (default 300):
# TIDE_HOURLY_BUDGET=300

# Optional analytics: the script address from Plausible's installation snippet.
# Leave empty (or out) to switch analytics off, for example on a development machine.
# PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/pa-XXXXX.js

# Temporary: shows what Plausible answers to a test event. Switch off again afterwards.
# PLAUSIBLE_DEBUG=1
