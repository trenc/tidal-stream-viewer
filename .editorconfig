root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[{*.go,go.mod,go.sum}]
indent_style = tab
indent_size = 4
tab_width = 4
trim_trailing_whitespace = true

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.{yml,yaml}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[{Makefile,**.mk}]
indent_style = tab
indent_size = 4
tab_width = 4
trim_trailing_whitespace = true
